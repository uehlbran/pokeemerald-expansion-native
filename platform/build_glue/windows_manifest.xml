<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  windows_manifest.xml: the application manifest every Windows executable of
  this project carries (windows_manifest.rc, linked through platform/target.mk):
  the process's active code page is UTF-8, so that the narrow strings the C
  runtime and the -A functions take and give (main's argv, fopen's and _open's
  paths) are UTF-8, as on Linux. Microsoft, "Use UTF-8 code pages in Windows
  apps" (learn.microsoft.com/en-us/windows/apps/design/globalizing/use-utf8-code-page):
  honoured from Windows version 1903 (May 2019 Update) on; this element and its
  namespace are that page's "Fusion manifest for an unpackaged Win32 app".
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity type="win32" name="pokeemerald-expansion-native" version="1.0.0.0"/>
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
