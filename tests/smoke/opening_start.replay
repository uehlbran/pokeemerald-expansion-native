# The start of the opening, shared: power-on, title, New Game, the speech, the
# name "Ab", the truck, Mom's house, the clock, the TV, and out the door into
# Littleroot Town with the controls free (dump 09_outside). Included by
# opening.replay (which goes on to the first battle, the lab and the save) and
# by debug_menu.replay (which opens the debug menu from here). Same rules as
# opening.replay: every step waits for a fact, except the `wait N` lines with
# their reasons.

# ---- 0. Before the game has set up its save blocks (the first step runs at the end of frame 1)
# The facts that read the save blocks give their pre-boot values instead of dereferencing NULL
# (inspect.c, read_fact); a regression to the dereference fails the gate here.
expect flag:2144=0
expect var:16384=0
expect player_name=none
expect map=none

# ---- 1. Boot: copyright screen, intro, title screen ------------------------
wait-until callback2=MainCB2_Intro max 1000
wait-until callback2=MainCB2 max 20000
wait-until task_first=Task_TitleScreenPhase3 max 600
dump 01_title
screenshot 01_title

# ---- 2. Title -> main menu (a fresh save has New Game and Options only) -----
press START
wait-until task_first=Task_HandleMainMenuInput max 600
dump 02_main_menu
screenshot 02_main_menu

# ---- 3. New Game: Birch's speech, boy, name ---------------------------------
press A
mash A until task_first=Task_NewGameBirchSpeech_ChooseGender max 3000
dump 03_gender
screenshot 03_gender
press A
mash A until task_first=Task_NewGameBirchSpeech_WaitPressBeforeNameChoice max 600
press A
wait-until callback2=CB2_NamingScreen max 300
wait-until fade_active=1 max 300
wait-until fade_active=0 max 300
wait 8  # settle
# settle; "A" typed on the upper-case page makes the keyboard swap to the lower-case page
press A
wait 40  # keyboard swap
# the swap is over; RIGHT moves the cursor from "a" to "b"
press RIGHT
wait 8  # turn on the spot
press A
wait 8  # settle
dump 04_naming
screenshot 04_naming
# START moves the cursor to OK, A confirms
press START
wait 8  # settle
press A
# "So you're Ab?" Yes; then the speech ends and the game starts
mash A until callback2=CB2_NewGame max 3000
wait-until callback2=CB2_Overworld max 3000
expect player_name=Ab
expect map_name=MAP_INSIDE_OF_TRUCK
dump 05_truck
screenshot 05_truck

# ---- 4. The truck: wait for the controls, walk out --------------------------
wait-until controls_locked=0 max 3000
hold RIGHT
wait-until map_name=MAP_LITTLEROOT_TOWN max 600
release RIGHT
# the arrival scene in Littleroot: Mom speaks, walks into the house; Mom's house 1F
wait-until script_running=1 max 600
mash A until map_name=MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_1F max 3000
wait-until script_running=1 max 600
mash A until controls_locked=0 max 3000
wait 20  # settle
dump 06_house
screenshot 06_house
# upstairs: the stairs are at (8,2) -> 2F (7,1)
hold UP
wait-until map_name=MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F max 600
release UP
# settle: the map's arrival script locks the controls a few frames after the map is up
wait-until callback2=CB2_Overworld max 600
wait 10  # settle
wait-until controls_locked=0 max 600
# the clock is on the wall at (5,1): stand at (5,2), face up, A
hold LEFT
wait-until pos=5,2 max 100
release LEFT
wait 20  # step finishes
press UP
wait 6  # turn on the spot
press A
mash A until callback2=CB2_WallClock max 600
wait-until task_first=Task_SetClock_HandleInput max 300
wait 20  # settle
press A
wait-until task_first=Task_SetClock_HandleConfirmInput max 300
wait 20  # settle
press UP
wait 6  # turn on the spot
press A
wait-until callback2=CB2_Overworld max 600
wait-until script_running=1 max 600
mash A until controls_locked=0 max 3000
wait 20  # settle
dump 07_clock_set
screenshot 07_clock_set
# ---- 6. Downstairs: Mom shows the TV, then out of the house ------------------
hold RIGHT
wait-until pos=7,2 max 100
release RIGHT
hold UP
wait-until map_name=MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_1F max 200
release UP
wait-until script_running=1 max 300
mash A until controls_locked=0 max 3000
wait 20  # settle
dump 08_mom_tv
hold RIGHT
wait-until pos=8,5 max 200
release RIGHT
hold DOWN
wait-until map_name=MAP_LITTLEROOT_TOWN max 300
release DOWN
wait-until controls_locked=0 max 600
wait 20  # settle
dump 09_outside
screenshot 09_outside
