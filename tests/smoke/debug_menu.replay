press START
release R
wait-until debug_menu_open=1 max 60
press DOWN times 2 # Party
press A
wait-until task_last=DebugTask_HandleMenuInput_General max 60
press DOWN times 8 # Clear Party
press A
wait-until debug_menu_open=0 max 60
wait-until controls_locked=0 max 60
expect party_count=0
expect party_species=none
expect pc_box0_count=2

hold R
press START
release R
wait-until debug_menu_open=1 max 60
press DOWN times 3 # Give X
press A
wait-until task_last=DebugTask_HandleMenuInput_General max 60

