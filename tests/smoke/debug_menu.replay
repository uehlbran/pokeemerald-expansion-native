# ---- The bag -------------------------------------------------------------------
press DOWN # BAG
press A
wait-until callback2=CB2_BagMenuFromStartMenu max 300
wait-until fade_active=1 max 30
wait-until fade_active=0 max 120
wait 20
screenshot bag_items
dump bag_items
press LEFT
wait 20  # the pocket switches to the last, the key items
screenshot bag_key_items
press B
wait-until task_last=Task_ShowStartMenu max 300 # the bag closes into the Start menu
wait 10  # settle
press B
wait-until controls_locked=0 max 300
wait 10  # settle

# ---- A trainer battle with the party as it is: Trainers > Trainer 1 = trainer 10 (an Aqua grunt), Try Battle
hold R
press START
release R
wait-until debug_menu_open=1 max 60
press DOWN times 6 # Trainers
press A
wait-until task_last=DebugTask_HandleMenuInput_General max 60
press DOWN # Trainer 1
press A
wait-until debug_step=0.0 max 60
press RIGHT
press UP # the grunt's id is 10
expect debug_input=10
press A
wait-until task_last=DebugTask_HandleMenuInput_General max 60
press DOWN times 7 # Try Battle
press A
wait-until in_battle=1 max 900
wait-until callback2=BattleMainCB2 max 1500
mash A until battle_main=HandleTurnActionSelectionState max 3000 # through the intro text to the player's choice
wait 30  # the prompt is drawn
dump a_battle
screenshot a_battle
mash A until in_battle=0 max 12000 # FIGHT with the first move, text and the next Pokemon, until the grunt is beaten
wait-until callback2=CB2_Overworld max 1500
wait-until controls_locked=0 max 1500
wait 20  # settle
dump a_battle_end
screenshot a_battle_end
expect in_battle=0
expect party_species=252,1,152,961,974,1402
expect pc_box_species:0=3,907

# ---- Phase B: clear the party (Party > Clear Party), then generations 4 to 9 -----------------
