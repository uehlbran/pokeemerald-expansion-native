# The debug menu (src/debug.c, DEBUG_OVERWORLD_MENU), driven natively: gate (e).
# R+Start in the overworld opens it; the list menus take A and B, the numeric entries
# the D-pad (UP/DOWN change the digit under the cursor by its place value, LEFT/RIGHT move
# the cursor to the next digit). Gives, a party and PC of every generation and expansion-only
# forms and items, the party menu and summary screens, the bag, trainer battles, flags and vars.
#
# Facts used beyond opening.replay (platform/inspect.h): debug_menu_open, debug_step,
# debug_input (the numeric entry's step and value), party_species:N, party_name:N,
# party_level:N, party_extras:N, pc_box0_count, pc_box_species:N, bag_item_count:ID, flag:ID,
# var:ID, party_move:N:M, party_slot, summary_species, battle_main.

# The opening up to standing outside in Littleroot Town.
include opening_start.replay
# opening_start ends just as the door-exit scene locks the controls: wait for them again
wait-until controls_locked=0 max 600
wait 10  # settle
expect party_count=0
expect pc_box0_count=0
expect debug_menu_open=0
expect debug_step=none
dump 10_littleroot
screenshot 10_littleroot

# ---- Open the debug menu: hold R and press START -----------------------------------
hold R
press START
release R
wait-until debug_menu_open=1 max 60
wait 10  # the window is drawn
dump 11_menu_open
screenshot 11_menu_open

# Flags & Vars > Set Flag XYZ: FLAG_SYS_POKEMON_GET (2144), which puts POKeMON on the Start menu
press DOWN times 8
press A
wait-until task_last=DebugTask_HandleMenuInput_General max 60
expect flag:2144=0
press A
wait-until debug_step=0.0 max 60
press RIGHT
press UP times 4
press RIGHT
press UP
press RIGHT
press UP times 2
press LEFT
press LEFT
press LEFT
press UP times 3
expect debug_input=2144
press A
wait-until flag:2144=1 max 10 # toggled; the entry stays open
press B
wait-until task_last=DebugTask_HandleMenuInput_General max 60 # back to the Flags & Vars list

# Flags & Vars > Set Var XYZ: VAR_TEMP_0 (16384, the first variable) to 7
expect var:16384=0
press DOWN
press A
wait-until debug_step=0.0 max 60
expect debug_input=16384
press A
wait-until debug_step=1.0 max 60
press UP times 7
expect debug_input=7
press A
wait-until var:16384=7 max 10
press B
wait-until task_last=DebugTask_HandleMenuInput_General max 60

# Flags & Vars > Toggle All badges: FLAG_BADGE08_GET (2158) set, so that the lead obeys at level 100
expect flag:2158=0
press DOWN times 10
press A
wait-until flag:2158=1 max 10

press B
wait-until task_last=DebugTask_HandleMenuInput_General max 60 # Flags & Vars -> the main menu
press DOWN times 3 # Give X
press A
wait-until task_last=DebugTask_HandleMenuInput_General max 60

