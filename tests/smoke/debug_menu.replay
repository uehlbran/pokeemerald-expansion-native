wait-until party_slot=4 max 20
press A
wait-until task_last=Task_HandleSelectionMenuInput max 60
press A # SUMMARY
wait-until task_first=Task_HandleInput max 300
wait-until fade_active=1 max 30
wait-until fade_active=0 max 120
expect summary_species=810
screenshot summary_b4
press B
wait-until summary_species=0 max 300 # the summary is closed
wait-until task_last=Task_HandleSelectionMenuInput max 300 # back in the party menu, at the mon's menu
wait 30  # the party menu fades in
press B
wait-until task_last=Task_HandleChooseMonInput max 60
press DOWN
wait-until party_slot=5 max 20
press A
wait-until task_last=Task_HandleSelectionMenuInput max 60
press A # SUMMARY
wait-until task_first=Task_HandleInput max 300
wait-until fade_active=1 max 30
wait-until fade_active=0 max 120
expect summary_species=1289
screenshot summary_b5
press B
wait-until summary_species=0 max 300 # the summary is closed
wait-until task_last=Task_HandleSelectionMenuInput max 300 # back in the party menu, at the mon's menu
wait 30  # the party menu fades in
press B
wait-until task_last=Task_HandleChooseMonInput max 60
press B
wait-until task_last=Task_ShowStartMenu max 300 # B leaves the party menu for the Start menu
wait 10  # settle
press B
wait-until controls_locked=0 max 300 # the Start menu closes
wait 10  # settle

# ---- A trainer battle with the party as it is: Trainers > Trainer 1 = trainer 10 (an Aqua grunt), Try Battle
hold R
press START
release R
wait-until debug_menu_open=1 max 60
press DOWN times 6 # Trainers
press A
wait-until task_last=DebugTask_HandleMenuInput_General max 60
press DOWN # Trainer 1
press A
wait-until debug_step=0.0 max 60
press RIGHT
press UP # the grunt's id is 10
expect debug_input=10
press A
wait-until task_last=DebugTask_HandleMenuInput_General max 60
press DOWN times 7 # Try Battle
press A
wait-until in_battle=1 max 900
wait-until callback2=BattleMainCB2 max 1500
mash A until battle_main=HandleTurnActionSelectionState max 3000 # through the intro text to the player's choice
wait 30  # the prompt is drawn
dump b_battle
screenshot b_battle
mash A until in_battle=0 max 12000 # FIGHT with the first move, text and the next Pokemon, until the grunt is beaten
wait-until callback2=CB2_Overworld max 1500
wait-until controls_locked=0 max 1500
wait 20  # settle
dump b_battle_end
screenshot b_battle_end
expect in_battle=0

# ---- Save from the Start menu, restart the process, Continue ---------------------------------
press START
wait-until task_last=Task_ShowStartMenu max 60
wait 10  # settle
press DOWN times 3 # SAVE
press A
mash A until controls_locked=0 max 3000
wait 20  # settle
expect save_counter=1
expect party_level:0=100
expect party_extras:0=shiny=1 dynamax=10 gmax=1 tera=13
expect party_move:0:0=33 # Tackle
expect party_move:0:1=0
expect party_move:0:3=0
dump 14_saved
screenshot 14_saved
restart

wait-until callback2=MainCB2_Intro max 1000
wait-until callback2=MainCB2 max 20000
wait-until task_first=Task_TitleScreenPhase3 max 600
press START
wait-until task_first=Task_HandleMainMenuInput max 600
press A # CONTINUE
wait-until callback2=CB2_Overworld max 1200
wait 10  # settle
wait-until controls_locked=0 max 600
dump 15_continued
screenshot 15_continued
