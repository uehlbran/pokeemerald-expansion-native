press A
wait-until debug_step=0.0 max 60
press RIGHT
press RIGHT
press UP times 4
press RIGHT
press UP
press LEFT
press LEFT
press LEFT
press UP
expect debug_input=1402
press A
wait-until debug_step=1.0 max 60
press RIGHT
press UP times 4
press LEFT
press DOWN
